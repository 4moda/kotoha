root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{rs,c,cc,cpp,cxx,h,hpp,hxx,cmake}]
indent_style = space
indent_size = 4

[CMakeLists.txt]
indent_style = space
indent_size = 4

[*.{ts,tsx,js,jsx,mjs,cjs,css,html,json,yml,yaml,md,toml}]
indent_style = space
indent_size = 2

[*.{bat,cmd,ps1}]
end_of_line = crlf
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
